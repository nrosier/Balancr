# Build inputs only — everything else bloats the context and can leak secrets.
node_modules
dist
data
.git
.github
.env
.env.*
!.env.example
*.db
*.db-*
coverage
# `**` because a bare `test` matches only the top-level directory — the browser
# tests live in web/test and would otherwise ride along into the build context.
**/test
*.log
