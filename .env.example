# ============================================================================
#  Balancr configuration
#  Copy to `.env` and `chmod 600 .env`. Never commit the real file.
#  Prompts, thresholds and per-user language live in the DATABASE, not here —
#  a webapp cannot edit .env. Only bootstrap secrets and defaults belong here.
#
#  Every variable left empty below is optional. Leave it empty — an empty value
#  means "not set", and a placeholder like `null` or `none` would be read as a
#  real value. The variables Balancr cannot start without are named as required
#  where they appear.
# ============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
# Used to build OIDC redirect URIs and cookie scope. Must be the public HTTPS URL.
PUBLIC_BASE_URL=https://balancr.example.com
DATABASE_PATH=/data/balancr.db

# --- Actual Budget -----------------------------------------------------------
# The API is a local sync engine, not a REST client: it caches the budget into
# ACTUAL_DATA_DIR. Exactly one process may own that directory.
ACTUAL_SERVER_URL=http://actual:5006
# Required.
ACTUAL_PASSWORD=
# Required. Settings -> Advanced -> Sync ID in the Actual UI.
ACTUAL_SYNC_ID=
# ONLY if your budget file is end-to-end encrypted, in which case this is the
# budget's own encryption password and NOT the ACTUAL_PASSWORD above. If your
# budget is not encrypted, leave it empty: Actual ignores it entirely, and
# Balancr will tell you by name if it turns out to be needed.
ACTUAL_E2E_PASSWORD=
ACTUAL_DATA_DIR=/data/actual

# --- Ghostfolio --------------------------------------------------------------
GHOSTFOLIO_URL=http://ghostfolio:3333
# The long-lived "security token" from your Ghostfolio account page. Balancr
# exchanges it for a short-lived JWT on each startup.
GHOSTFOLIO_SECURITY_TOKEN=

# --- Gemini ------------------------------------------------------------------
# The whole AI layer is optional. Leave the credential below empty and Balancr
# starts anyway: the aggregation, the four overspend signals, the burn rate and
# the net-worth history are computed here and never involved a model. The pages
# that would have needed one say so and name the variable to set.
# `true` means "on if it is configured", not "on". Set it to `false` to pause
# spending without editing a key out of this file and back in.
AI_ENABLED=true
# `vertex`   -> EU data residency, IAM, audit logs. Recommended.
# `aistudio` -> simple API key. NEVER use a free-tier key: the free tier may use
#               your prompts to improve Google's products. This app sends
#               financial aggregates.
GEMINI_PROVIDER=vertex
GEMINI_API_KEY=
# Model ids are config, not code, so a deprecation is a one-line change.
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_DEEP=gemini-3.1-pro-preview
# Hard month-to-date ceiling. On breach Balancr serves cached output and shows a
# banner; it never fails hard and never silently overspends. Zero is not an
# exhausted allowance but an off switch, reported the same way as an absent key.
GEMINI_MONTHLY_BUDGET_EUR=15
# Google will not cache a context below this many tokens, so Balancr does not ask
# it to. Raise it if Google raises the floor; set it to 0 to attempt the create
# regardless and let the provider answer.
GEMINI_CACHE_MIN_TOKENS=1024
# Vertex only:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-sa.json

# --- Auth --------------------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 48
SESSION_SECRET=

# Peers allowed to set X-Forwarded-* / X-authentik-* headers. Set this to your
# Traefik network ONLY. Without it, anyone reaching the container directly can
# authenticate as you by setting a header.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Authentik OIDC. Balancr runs a real code flow (PKCE) rather than trusting
# forward-auth headers, so it keeps working if the proxy changes.
#
# The issuer must be https:// in production, and that is a real requirement rather
# than tidiness: OIDC lets a client skip checking the ID token's signature when the
# token comes straight from the token endpoint over TLS, and the library takes that
# shortcut. Over plain http:// on an internal network, anything that can answer the
# token request can claim to be any user.
AUTH_OIDC_ISSUER=https://authentik.example.com/application/o/balancr/
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
#
# The redirect URI is not configured here. It is derived as
# <PUBLIC_BASE_URL>/auth/callback, and Authentik compares it byte for byte:
#
#   PUBLIC_BASE_URL=https://balancr.example.com
#   -> register https://balancr.example.com/auth/callback  (matching mode: Strict)
#
# Deriving it beats reading it from the request's Host header, which would let a
# request choose where the authorization code is sent. It does mean a wrong
# PUBLIC_BASE_URL surfaces as "invalid redirect_uri" at Authentik rather than as a
# complaint about PUBLIC_BASE_URL. Balancr prints the value it will send on
# startup ("OIDC login enabled") — compare that line against Authentik.
# See the Authentik section in README.md for the rest of the provider setup.

# Session lifetime in hours, counted from the last request that renewed it.
# Authentik decides who you are; this only decides how long Balancr takes its
# word for it. Sessions live in SQLite, so lowering this affects existing ones.
SESSION_TTL_HOURS=168

# Break-glass local login, for when Authentik itself is what broke. Off by
# default; when on, still refused unless the request originates inside
# AUTH_LOCAL_ALLOWED_CIDRS — so it works over LAN/VPN but never through the
# public tunnel. Password AND TOTP, always: there is no password-only local login.
#
# The range is matched against the TCP peer address, not X-Forwarded-For, which is
# the only reason the gate is worth anything — a header is exactly what a request
# arriving through the tunnel would set. So Traefik's own address must NOT be in
# this range: if it is, everything it forwards is inside the range too.
#
# Set the password with:  npm run auth:local -- --email you@example.com
# It prints the TOTP enrolment URI once. There is no web UI for it, deliberately:
# the credential exists for when nobody can sign in.
AUTH_LOCAL_ENABLED=false
AUTH_LOCAL_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8

# --- Rate limiting -----------------------------------------------------------
# Counters live in Balancr's SQLite rather than in memory, so a restart does not
# hand back a fresh allowance.
# Ordinary bucket, per client IP per minute. A dashboard load is a handful of
# requests, so this is generous by design.
RATE_LIMIT_API_PER_MINUTE=300
# Anything that can call Gemini, per client IP per HOUR. This one is a spend
# limit: being logged in is what makes a caller expensive, so authentication is
# no protection. The nightly job precomputes everything the UI shows, so normal
# browsing never touches it.
RATE_LIMIT_AI_PER_HOUR=30

# --- Background jobs ---------------------------------------------------------
# Off schedules nothing at all: routes and stored data still work, which is what
# you want when opening a copy of the database or running a second instance.
JOBS_ENABLED=true
# Sync + aggregate cadence. Actual is local, so this is cheap; the limit is how
# often you want Ghostfolio's price provider called.
JOBS_SYNC_INTERVAL_MINUTES=60
# Local hour for the nightly deep pass. Local rather than UTC, so it stays
# overnight through the summer.
JOBS_NIGHTLY_HOUR=3
# Months of facts recomputed each pass. Baseline history is fetched on top of
# this, so lowering it does not weaken the norms.
JOBS_HISTORY_MONTHS=24

# --- Backups -----------------------------------------------------------------
# The nightly snapshot is encrypted with this passphrase, and leaving it empty is
# how you switch backups off — there is no separate on/off flag. Empty is the
# right setting if the volume is already covered by a host snapshot or a restic
# job; the backup job then logs one line saying so and reports success.
#
# WRITE IT DOWN SOMEWHERE THAT IS NOT THIS FILE. Nothing can recover a snapshot
# without it: not Balancr, not the database, not Google. Sixteen characters
# minimum, because these files sit on disk where they can be attacked offline for
# as long as someone likes, and no key-derivation function saves a short one.
#
# Most of the database is recomputed from Actual and Ghostfolio every night and
# would cost nothing to lose. What this protects is the part that would not come
# back: every category description, COICOP code and sensitivity flag you built by
# answering questions about your own budget, plus the prompt versions and the AI
# ledger.
BACKUP_PASSPHRASE=
# Where snapshots are written. Under ./data by default, which means inside the
# one volume — deliberately, and with a plain limit: a backup living in the
# volume it backs up survives a bad migration, a mistaken bulk edit and a
# corrupted page, and does NOT survive losing the volume. Point this at another
# mount, or copy the files off, if you want the second case covered too.
# `/data/actual` is not included: it is a cache of a budget the Actual server
# still holds, and re-downloading it is one call.
BACKUP_DIR=./data/backups
# How many snapshots to keep. A file is deleted only when it is both older than
# this many days AND surplus to this many files, so taking a backup by hand
# before a risky change never evicts a scheduled one, and an instance that was
# switched off for a month does not come back and delete its own history for
# being old.
BACKUP_KEEP=14

# --- Investing ---------------------------------------------------------------
# The funds Balancr's advice is allowed to propose. Nothing outside this file can
# be suggested, which is the point of it: a model asked what to buy will answer
# with a ticker it has read somewhere, and this is the list that outranks it.
#
# There is no default list, deliberately — an empty universe means advice proposes
# nothing and says so. config/fund-universe.example.yaml is a starting point of
# eleven Belgian-accessible accumulating UCITS ETFs; copying it is not the same as
# having vetted it, and each entry carries the date somebody last checked it
# against the issuer's own page.
#
#   cp config/fund-universe.example.yaml data/fund-universe.yaml
#
# In a container, /app is read-only: point this at the data volume so the list
# survives an upgrade.
#
#   FUND_UNIVERSE_PATH=/data/fund-universe.yaml
FUND_UNIVERSE_PATH=./config/fund-universe.yaml
# How long a fund's last_verified date counts for, in days. Past this, that entry
# stops being proposable until someone re-checks it — a list everybody agrees
# should be reviewed some day never is, unless it stops working. Ongoing charges
# are published once a year, so a year is the honest interval.
FUND_UNIVERSE_MAX_AGE_DAYS=365

# Where the dated Belgian tax rules live: beurstaks tiers, roerende voorheffing, the
# Reynders levy and the tax on realised gains, each with the law it cites and the day
# somebody last checked it. Balancr ships this file filled in and uses it in place, so
# there is nothing to do here — the variable exists so you can correct a rate without
# waiting for a release, which a government makes necessary sooner or later.
#
#   cp config/belgian-tax.yaml data/belgian-tax.yaml
#   TAX_RULES_PATH=/data/belgian-tax.yaml
#
# There is deliberately no max-age setting to go with it. An out-of-date fund entry
# means proposing the wrong instrument, so #40 refuses to act on one; an out-of-date
# tax rate is usually still the rate, and a figure carrying its citation and its
# verification date beats no figure. Staleness here is shown, not enforced.
TAX_RULES_PATH=./config/belgian-tax.yaml

# --- Egress ------------------------------------------------------------------
# Balancr refuses to connect to a host nobody configured. The allowlist is built
# from the values above — Actual, Ghostfolio, the OIDC issuer and Google's Gemini
# endpoint — so there is nothing to keep in step here; moving Ghostfolio to a new
# hostname needs no second edit.
#
# What this defends against is a dependency rather than a network: this process
# holds your Actual password, Ghostfolio token, Gemini key and a database of your
# finances, and the realistic attack on that is a compromised npm package posting
# the lot somewhere. It is not a sandbox — see src/egress.ts for exactly what it
# does and does not cover — and it is the reason to ALSO restrict egress at the
# firewall if you can.
#
#   enforce  refuse the connection and log the host (never the path or query)
#   warn     allow it and log the host, to see what a new dependency wants
#   off      leave fetch alone
EGRESS_MODE=enforce
# Extra hostnames to allow. HOSTNAMES, not URLs: proxy.internal, not
# https://proxy.internal:8443/. Needed for an outbound HTTP proxy, or if a future
# dependency reaches somewhere none of the above covers — so the answer to that
# day is a line here rather than EGRESS_MODE=off.
EGRESS_EXTRA_HOSTS=

# --- Locale ------------------------------------------------------------------
# UI language and number formatting are deliberately SEPARATE. Language swaps
# message catalogues; FORMAT_LOCALE keeps amounts Belgian (EUR 1.234,56) in
# every language, so figures always match your bank and broker documents.
SUPPORTED_LOCALES=en,nl
# Fallback for new users and for cron jobs / the monthly digest, which have no
# request context of their own. This is the reason the variable exists.
DEFAULT_LOCALE=en
FORMAT_LOCALE=nl-BE
TZ=Europe/Brussels
BASE_CURRENCY=EUR
