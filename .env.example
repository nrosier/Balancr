# ============================================================================
#  Balancr configuration
#  Copy to `.env` and `chmod 600 .env`. Never commit the real file.
#  Prompts, thresholds and per-user language live in the DATABASE, not here —
#  a webapp cannot edit .env. Only bootstrap secrets and defaults belong here.
# ============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
# Used to build OIDC redirect URIs and cookie scope. Must be the public HTTPS URL.
PUBLIC_BASE_URL=https://balancr.example.com
DATABASE_PATH=/data/balancr.db

# --- Actual Budget -----------------------------------------------------------
# The API is a local sync engine, not a REST client: it caches the budget into
# ACTUAL_DATA_DIR. Exactly one process may own that directory.
ACTUAL_SERVER_URL=http://actual:5006
ACTUAL_PASSWORD=
# Settings -> Advanced -> Sync ID in the Actual UI
ACTUAL_SYNC_ID=
# ONLY if your budget file is end-to-end encrypted. Separate from ACTUAL_PASSWORD.
ACTUAL_E2E_PASSWORD=
ACTUAL_DATA_DIR=/data/actual

# --- Ghostfolio --------------------------------------------------------------
GHOSTFOLIO_URL=http://ghostfolio:3333
# The long-lived "security token" from your Ghostfolio account page. Balancr
# exchanges it for a short-lived JWT on each startup.
GHOSTFOLIO_SECURITY_TOKEN=

# --- Gemini ------------------------------------------------------------------
# `vertex`   -> EU data residency, IAM, audit logs. Recommended.
# `aistudio` -> simple API key. NEVER use a free-tier key: the free tier may use
#               your prompts to improve Google's products. This app sends
#               financial aggregates.
GEMINI_PROVIDER=vertex
GEMINI_API_KEY=
# Model ids are config, not code, so a deprecation is a one-line change.
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_DEEP=gemini-3.1-pro-preview
# Hard month-to-date ceiling. On breach Balancr serves cached output and shows a
# banner; it never fails hard and never silently overspends.
GEMINI_MONTHLY_BUDGET_EUR=15
# Vertex only:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-sa.json

# --- Auth --------------------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 48
SESSION_SECRET=

# Peers allowed to set X-Forwarded-* / X-authentik-* headers. Set this to your
# Traefik network ONLY. Without it, anyone reaching the container directly can
# authenticate as you by setting a header.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Authentik OIDC. Balancr runs a real code flow (PKCE) rather than trusting
# forward-auth headers, so it keeps working if the proxy changes.
AUTH_OIDC_ISSUER=https://authentik.example.com/application/o/balancr/
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Break-glass local login. Off by default; when on, still refused unless the
# request originates inside AUTH_LOCAL_ALLOWED_CIDRS — so it works over LAN/VPN
# but never through the public tunnel. Requires TOTP.
AUTH_LOCAL_ENABLED=false
AUTH_LOCAL_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8

# --- Background jobs ---------------------------------------------------------
# Off schedules nothing at all: routes and stored data still work, which is what
# you want when opening a copy of the database or running a second instance.
JOBS_ENABLED=true
# Sync + aggregate cadence. Actual is local, so this is cheap; the limit is how
# often you want Ghostfolio's price provider called.
JOBS_SYNC_INTERVAL_MINUTES=60
# Local hour for the nightly deep pass. Local rather than UTC, so it stays
# overnight through the summer.
JOBS_NIGHTLY_HOUR=3
# Months of facts recomputed each pass. Baseline history is fetched on top of
# this, so lowering it does not weaken the norms.
JOBS_HISTORY_MONTHS=24

# --- Locale ------------------------------------------------------------------
# UI language and number formatting are deliberately SEPARATE. Language swaps
# message catalogues; FORMAT_LOCALE keeps amounts Belgian (EUR 1.234,56) in
# every language, so figures always match your bank and broker documents.
SUPPORTED_LOCALES=en,nl
# Fallback for new users and for cron jobs / the monthly digest, which have no
# request context of their own. This is the reason the variable exists.
DEFAULT_LOCALE=en
FORMAT_LOCALE=nl-BE
TZ=Europe/Brussels
BASE_CURRENCY=EUR
