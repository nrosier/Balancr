{
  "name": "balancr",
  "version": "0.4.0",
  "private": true,
  "description": "Self-hosted AI budget and portfolio advisor for Actual Budget and Ghostfolio",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "badges:check": "node scripts/check-badges.mjs",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.20.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "i18next": "^26.4.1",
    "openid-client": "^6.8.7",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrosier/Balancr.git"
  }
}
